#!/usr/bin/env python3
"""Run shell commands on discfw over its USB serial console, or push a file.

disc-sh 'cmd' ['cmd' ...]      run each command, print output and exit code
disc-sh --push LOCAL REMOTE    copy a file (raw bytes over the console, sha256-checked)
disc-sh --probe                print whatever the console shows
"""
import glob
import hashlib
import os
import select
import sys
import termios
import time
import tty

PORT = os.environ.get("DISC_TTY") or (glob.glob("/dev/serial/by-id/usb-discfw_*-if00") or ["/dev/serial/by-id/usb-discfw_discfw_Serial_discfw-if00"])[0]


def open_port():
    fd = os.open(PORT, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    tty.setraw(fd)
    attrs = termios.tcgetattr(fd)
    attrs[4] = attrs[5] = termios.B115200
    termios.tcsetattr(fd, termios.TCSANOW, attrs)
    return fd


def drain(fd, quiet=0.3, limit=2.0):
    buf = b""
    end = time.time() + limit
    last = time.time()
    while time.time() < end:
        r, _, _ = select.select([fd], [], [], 0.05)
        if r:
            chunk = os.read(fd, 65536)
            if chunk:
                buf += chunk
                last = time.time()
        elif time.time() - last > quiet:
            break
    return buf


def run(fd, cmd, timeout):
    tag = f"{os.getpid()}_{int(time.time() * 1000) % 100000000}"
    begin, end = f"__BEGIN_{tag}__", f"__END_{tag}__"
    os.write(fd, f'echo __B""EGIN_{tag}__; {cmd}; echo __E""ND_{tag}__ rc=$?\n'.encode())
    buf = b""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([fd], [], [], 0.1)
        if r:
            buf += os.read(fd, 65536)
            text = buf.decode("utf-8", "replace")
            if end in text:
                body = text.split(begin, 1)[1] if begin in text else text
                body, tail = body.split(end, 1)
                return body.replace("\r", "").strip("\n"), tail.split("\n", 1)[0].strip()
    return buf.decode("utf-8", "replace").replace("\r", ""), "TIMEOUT"


def push(fd, local, remote):
    data = open(local, "rb").read()
    want = hashlib.sha256(data).hexdigest()
    os.write(fd, f"o=$(stty -g); stty raw -echo; echo __RE\"\"ADY__; head -c {len(data)} > '{remote}.new'; stty $o; echo __PU\"\"SHED__\n".encode())
    buf = b""
    deadline = time.time() + 10
    while b"__READY__" not in buf:
        if time.time() > deadline:
            sys.exit(f"push: no ready marker: {buf!r}")
        r, _, _ = select.select([fd], [], [], 0.1)
        if r:
            buf += os.read(fd, 65536)
    time.sleep(0.2)
    off, start, shown = 0, time.time(), 0
    while off < len(data):
        _, w, _ = select.select([], [fd], [], 30)
        if not w:
            sys.exit(f"push stalled at {off}")
        try:
            off += os.write(fd, data[off:off + 16384])
        except BlockingIOError:
            continue
        if off - shown >= 1 << 20 or off == len(data):
            shown = off
            print(f"\r{off * 100 // len(data)}% {off / max(time.time() - start, 1e-3) / 1e6:.2f} MB/s", end="", flush=True, file=sys.stderr)
    buf = drain(fd, 1.0, 120)
    if b"__PUSHED__" not in buf:
        sys.exit(f"\npush: no completion marker: {buf[-200:]!r}")
    out, rc = run(fd, f"mv '{remote}.new' '{remote}' && sha256sum '{remote}'", 60)
    print(f"\n{out}\n{'ok' if want in out else 'SHA256 MISMATCH, expected ' + want}")
    if want not in out:
        sys.exit(1)


def main():
    fd = open_port()
    if sys.argv[1:] == ["--probe"]:
        os.write(fd, b"\n")
        print(drain(fd).decode("utf-8", "replace"))
        return
    os.write(fd, b"\x03\x15\n")
    drain(fd, 0.2, 1.0)
    if sys.argv[1:2] == ["--push"] and len(sys.argv) == 4:
        push(fd, sys.argv[2], sys.argv[3])
        return
    timeout = float(os.environ.get("DISC_TIMEOUT", "20"))
    for c in sys.argv[1:] or [line.rstrip("\n") for line in sys.stdin if line.strip()]:
        out, rc = run(fd, c, timeout)
        print(f"$ {c}\n{out}\n[{rc}]", flush=True)


main()
