#!/bin/sh
# One gadget per boot mode (/run/discfw.mode), built once and never rebuilt.
# FiiO's kernel drops every other function from a config with uac2, so USB DAC is uac2 alone (no serial shell).
# It is never unbound: unbinding while the host streams can crash the kernel; the watchdog reset follows anyway.
C=/sys/kernel/config/usb_gadget
ROLE=/sys/class/usb_role/13500000.otg_new-role-switch/role
M=/run/discfw.mode
mode=$(cat $M 2>/dev/null)

gadget() {
	G=$C/$1
	mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 || return 1
	echo "$2" > $G/idVendor
	echo "$3" > $G/idProduct
	echo 0x0200 > $G/bcdUSB
	set -- $4
	echo "$1" > $G/bDeviceClass
	echo "$2" > $G/bDeviceSubClass
	echo "$3" > $G/bDeviceProtocol
	echo discfw > $G/strings/0x409/manufacturer
	echo discfw > $G/strings/0x409/serialnumber
	echo 250 > $G/configs/c.1/MaxPower
}

acm() {
	mkdir -p $G/functions/acm.usb0 && ln -s $G/functions/acm.usb0 $G/configs/c.1/
}

player() {
	gadget disc 0x0525 0xa4a7 "0x02 0x00 0x00" && acm || return 1
	echo "discfw Serial" > $G/strings/0x409/product
	echo ACM > $G/configs/c.1/strings/0x409/configuration
}

storage() {
	F=$C/disc/functions/mass_storage.0
	for i in $(seq 1 50); do [ -b /dev/mmcblk0 ] && break; sleep 0.1; done
	[ -b /dev/mmcblk0 ] || return 1
	gadget disc 0x0525 0xa4a5 "0xef 0x02 0x01" && acm && mkdir -p $F || return 1
	echo "discfw USB storage" > $G/strings/0x409/product
	echo "ACM + storage" > $G/configs/c.1/strings/0x409/configuration
	echo 0 > $F/lun.0/ro
	echo 1 > $F/lun.0/removable
	echo 0 > $F/lun.0/nofua
	echo /dev/mmcblk0 > $F/lun.0/file && ln -s $F $G/configs/c.1/
}

usbdac() {
	F=$C/dac/functions/uac2.usb0
	gadget dac 0x1d6b 0x0101 "0x00 0x00 0x00" && mkdir -p $F || return 1
	echo "discfw USB DAC" > $G/strings/0x409/product
	echo "USB DAC" > $G/configs/c.1/strings/0x409/configuration
	echo 3 > $F/c_chmask
	echo 4 > $F/c_ssize
	echo 44100 > $F/c_srate
	echo 3 > $F/p_chmask
	echo 2 > $F/p_ssize
	echo 48000 > $F/p_srate
	ln -s $F $G/configs/c.1/
}

remove() {
	[ -d $C/$1 ] || return 0
	echo > $C/$1/UDC 2>/dev/null
	find $C/$1/configs -type l -exec rm {} \; 2>/dev/null
	rmdir $C/$1/configs/c.1/strings/0x409 $C/$1/configs/c.1 $C/$1/functions/* $C/$1/strings/0x409 $C/$1 2>/dev/null
}

setup() {
	grep -q " /sys/kernel/config " /proc/mounts || mount -t configfs none /sys/kernel/config
	[ -d $C/disc ] || [ -d $C/dac ] && return 0
	case "$mode" in
	storage | usbdac)
		$mode && return 0
		logger -t usbgadget "$mode gadget failed, falling back to player"
		remove disc
		remove dac
		echo player > $M
		;;
	esac
	player
}

bind() {
	g=$(ls -d $C/dac $C/disc 2>/dev/null | head -1)
	for i in $(seq 1 30); do
		[ -w $ROLE ] && echo device > $ROLE
		udc=$(ls /sys/class/udc 2>/dev/null | head -1)
		[ -n "$udc" ] && echo "$udc" > $g/UDC 2>/dev/null && return 0
		sleep 1
	done
}

case "$1" in
start)
	setup && { bind & }
	;;
stop)
	[ -d $C/dac ] || echo > $C/disc/UDC 2>/dev/null
	;;
esac
