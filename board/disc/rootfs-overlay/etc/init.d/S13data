#!/bin/sh
# Persistent state in /usr/data/discfw on the stock "userdata" UBI partition. Never formats it: if it will not
# attach or mount, a tmpfs takes its place and nothing persists.
D=/usr/data
S=$D/discfw

attach() {
	n=$(sed -n 's/^mtd\([0-9]*\):.*"userdata"$/\1/p' /proc/mtd)
	[ -n "$n" ] || return 1
	for u in /sys/class/ubi/ubi[0-9]*; do
		[ "$(cat "$u/mtd_num" 2>/dev/null)" = "$n" ] && { basename "$u"; return 0; }
	done
	ubiattach -m "$n" -d 1 /dev/ubi_ctrl >/dev/null 2>&1 && echo ubi1
}

mount_data() {
	u=$(attach)
	for i in $(seq 1 50); do [ -n "$u" ] && [ -e "/dev/${u}_0" ] && break; sleep 0.1; done
	if [ -z "$u" ] || ! mount -t ubifs -o sync "/dev/${u}_0" $D 2>/dev/null; then
		echo "data: userdata unavailable, state will not persist" >&2
		mount -t tmpfs -o mode=0755,size=4m tmpfs $D
	fi
}

start() {
	grep -q " $D " /proc/mounts || mount_data
	mkdir -p $S/wifi $S/bluetooth $S/bluealsa $S/ssh/root $S/mpd/playlists
	chmod 700 $S/ssh $S/ssh/root $S/bluetooth
	[ -s $S/hostname ] && hostname "$(cat $S/hostname)"
	now=$(date +%s)
	saved=$(cat $S/clock 2>/dev/null)
	[ -n "$saved" ] && [ "$saved" -gt "$now" ] && date -s "@$saved" >/dev/null
	mode=$(cat $S/mode.next 2>/dev/null)
	rm -f $S/mode.next
	case "$mode" in storage | usbdac) ;; *) mode=player ;; esac
	echo $mode > /run/discfw.mode
}

stop() {
	grep -q " $D " /proc/mounts || return 0
	date +%s > $S/clock
	sync
	umount $D 2>/dev/null
}

case "$1" in
start|stop) "$1" ;;
*) echo "Usage: $0 {start|stop}" >&2; exit 1 ;;
esac
