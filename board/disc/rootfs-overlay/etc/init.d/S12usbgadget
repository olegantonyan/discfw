#!/bin/sh
G=/sys/kernel/config/usb_gadget/disc
ROLE=/sys/class/usb_role/13500000.otg_new-role-switch/role

setup() {
	grep -q " /sys/kernel/config " /proc/mounts || mount -t configfs none /sys/kernel/config
	[ -d $G ] && return 0
	mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/acm.usb0 || return 1
	echo 0x0525 > $G/idVendor
	echo 0xa4a7 > $G/idProduct
	echo 0x0200 > $G/bcdUSB
	echo 0x02 > $G/bDeviceClass
	echo discfw > $G/strings/0x409/manufacturer
	echo "discfw Serial" > $G/strings/0x409/product
	echo discfw > $G/strings/0x409/serialnumber
	echo ACM > $G/configs/c.1/strings/0x409/configuration
	echo 250 > $G/configs/c.1/MaxPower
	ln -s $G/functions/acm.usb0 $G/configs/c.1/
}

bind() {
	for i in $(seq 1 30); do
		[ -w $ROLE ] && echo device > $ROLE
		udc=$(ls /sys/class/udc 2>/dev/null | head -1)
		[ -n "$udc" ] && echo "$udc" > $G/UDC 2>/dev/null && return 0
		sleep 1
	done
}

case "$1" in
start)
	setup && { bind & }
	;;
stop)
	echo > $G/UDC 2>/dev/null
	;;
esac
