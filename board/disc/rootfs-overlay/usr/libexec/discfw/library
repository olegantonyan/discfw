#!/bin/sh
# Library maintenance. Usage: library reset   (drop the MPD database and scan from scratch)
D=/usr/data/discfw/mpd
case "$1" in
reset)
	touch /run/mpd.hold
	killall mpd 2>/dev/null
	for i in $(seq 1 50); do pidof mpd > /dev/null || break; sleep 0.1; done
	rm -f $D/database $D/database.bad
	rm -f /run/mpd.hold
	for i in $(seq 1 100); do [ -S /run/mpd.sock ] && mpc -q -h /run/mpd.sock update 2>/dev/null && break; sleep 0.3; done
	;;
*)
	echo "usage: library reset" >&2
	exit 2
	;;
esac
