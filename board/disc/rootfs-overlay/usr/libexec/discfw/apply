#!/bin/sh
# Applies a discfw setting that needs a service change. Called by discsys with the key name.
L=/usr/libexec/discfw
v=$(discfw cfg "$1")
case "$1" in
wifi.enabled) [ "$v" = 1 ] && $L/wifi on || $L/wifi off ;;
bt.enabled | bt.battery) [ "$(discfw cfg bt.enabled)" = 1 ] && $L/bt on || $L/bt off ;;
net.mpd | net.mpd_password | play.replaygain) killall mpd 2>/dev/null ;;
net.ssh) [ "$v" = 1 ] && /etc/init.d/S50dropbear start || /etc/init.d/S50dropbear stop ;;
*) exit 2 ;;
esac
