config BR2_PACKAGE_DISCSYS
	bool "discsys"
	depends on BR2_USE_WCHAR # libglib2
	depends on BR2_TOOLCHAIN_HAS_THREADS # libglib2
	depends on BR2_USE_MMU # libglib2
	select BR2_PACKAGE_LIBDISC
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBMPDCLIENT
	help
	  System daemon: keys, screen power, power profiles, settings,
	  output policy, Bluetooth/Wi-Fi management, modes. CLI discfw.
